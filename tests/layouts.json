        ],
        "active": 1
      },
      "written": "{\"version\":2,\"layout\":{\"tabs\":[\"b\",\"c\"],\"active\":1}}"
    },
    {
      "name": "a tree kept under another version is none",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "version": 2,
      "stored": "{\"version\":1,\"layout\":{\"tabs\":[\"b\",\"c\"]}}",
      "refused": true,
      "expect": {
        "tabs": [
          "a",
          "b",
          "c"
        ],
        "active": 0
      },
      "written": "{\"version\":2,\"layout\":{\"tabs\":[\"a\",\"b\",\"c\"],\"active\":0}}"
    },
    {
      "name": "versions compare as JSON values: 2 is not \"2\"",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "version": 2,
      "stored": "{\"version\":\"2\",\"layout\":{\"tabs\":[\"b\",\"c\"]}}",
      "refused": true,
      "expect": {
        "tabs": [
          "a",
          "b",
          "c"
        ],
        "active": 0
      },
      "written": "{\"version\":2,\"layout\":{\"tabs\":[\"a\",\"b\",\"c\"],\"active\":0}}"
    },
    {
      "name": "a version can be a string",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "version": "desk-3",
      "stored": "{\"version\":\"desk-3\",\"layout\":{\"tabs\":[\"c\"]}}",
      "refused": false,
      "expect": {
        "tabs": [
          "c"
        ],
        "active": 0
      },
      "written": "{\"version\":\"desk-3\",\"layout\":{\"tabs\":[\"c\"],\"active\":0}}"
    },
    {
      "name": "fields an envelope does not have are ignored",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "version": 2,
      "stored": "{\"version\":2,\"layout\":{\"tabs\":[\"a\"]},\"floating\":[{\"layout\":{\"tabs\":[\"b\"]}}]}",
      "refused": false,
      "expect": {
        "tabs": [
          "a"
        ],
        "active": 0
      },
      "written": "{\"version\":2,\"layout\":{\"tabs\":[\"a\"],\"active\":0}}"
    },
    {
      "name": "an envelope with no layout is none",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "version": 2,
      "stored": "{\"version\":2}",
      "refused": true,
      "expect": {
        "tabs": [
          "a",
          "b",
          "c"
        ],
        "active": 0
      },
      "written": "{\"version\":2,\"layout\":{\"tabs\":[\"a\",\"b\",\"c\"],\"active\":0}}"
    }
  ]
}
