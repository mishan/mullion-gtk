        "a",
        "b",
        "c"
      ],
      "stored": "{\"dir\":\"row\",\"size\":[0.001,12345.678],\"kids\":[{\"tabs\":[\"a\"]},{\"tabs\":[\"b\"]}]}",
      "refused": false,
