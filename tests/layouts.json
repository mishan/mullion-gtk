{
  "about": "Layout cases for mullion and every implementation of its model. Generated by tools/layouts.mjs; see docs/layout.md.",
  "cases": [
    {
      "name": "a leaf comes back with its front tab defaulted to the first",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "stored": "{\"tabs\":[\"a\",\"b\"]}",
      "refused": false,
      "expect": {
        "tabs": [
          "a",
          "b"
        ],
        "active": 0
      },
      "written": "{\"tabs\":[\"a\",\"b\"],\"active\":0}"
    },
    {
      "name": "a leaf keeps the tab that was in front",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "stored": "{\"tabs\":[\"a\",\"b\"],\"active\":1}",
      "refused": false,
      "expect": {
        "tabs": [
          "a",
          "b"
        ],
        "active": 1
      },
      "written": "{\"tabs\":[\"a\",\"b\"],\"active\":1}"
    },
    {
      "name": "a front tab past the end is the last one",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "stored": "{\"tabs\":[\"a\",\"b\"],\"active\":5}",
      "refused": false,
      "expect": {
        "tabs": [
          "a",
          "b"
        ],
        "active": 1
      },
      "written": "{\"tabs\":[\"a\",\"b\"],\"active\":1}"
    },
    {
      "name": "a front tab that is not a whole number refuses the layout",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "stored": "{\"tabs\":[\"a\",\"b\"],\"active\":1.5}",
      "refused": true,
      "expect": {
        "tabs": [
          "a",
          "b",
          "c"
        ],
        "active": 0
      },
      "written": "{\"tabs\":[\"a\",\"b\",\"c\"],\"active\":0}"
    },
    {
      "name": "a negative front tab refuses the layout",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "stored": "{\"tabs\":[\"a\",\"b\"],\"active\":-1}",
      "refused": true,
      "expect": {
        "tabs": [
          "a",
          "b",
          "c"
        ],
        "active": 0
      },
      "written": "{\"tabs\":[\"a\",\"b\",\"c\"],\"active\":0}"
    },
    {
      "name": "a front tab that is a string refuses the layout",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "stored": "{\"tabs\":[\"a\",\"b\"],\"active\":\"1\"}",
      "refused": true,
      "expect": {
        "tabs": [
          "a",
          "b",
          "c"
        ],
        "active": 0
      },
      "written": "{\"tabs\":[\"a\",\"b\",\"c\"],\"active\":0}"
    },
    {
      "name": "a tab that is not a string refuses the layout",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "stored": "{\"tabs\":[\"a\",2]}",
      "refused": true,
      "expect": {
        "tabs": [
          "a",
          "b",
          "c"
        ],
        "active": 0
      },
      "written": "{\"tabs\":[\"a\",\"b\",\"c\"],\"active\":0}"
    },
    {
      "name": "a leaf with no tabs is no layout",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "stored": "{\"tabs\":[]}",
      "refused": true,
      "expect": {
        "tabs": [
          "a",
          "b",
          "c"
        ],
        "active": 0
      },
      "written": "{\"tabs\":[\"a\",\"b\",\"c\"],\"active\":0}"
    },
    {
      "name": "fields a leaf does not have are ignored",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "stored": "{\"tabs\":[\"b\"],\"front\":\"b\",\"slot\":\"end\"}",
      "refused": false,
      "expect": {
        "tabs": [
          "b"
        ],
        "active": 0
      },
      "written": "{\"tabs\":[\"b\"],\"active\":0}"
    },
    {
      "name": "a whole number written as a decimal is a whole number",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "stored": "{\"tabs\":[\"a\",\"b\"],\"active\":1.0}",
      "refused": false,
      "expect": {
        "tabs": [
          "a",
          "b"
        ],
        "active": 1
      },
      "written": "{\"tabs\":[\"a\",\"b\"],\"active\":1}"
    },
    {
      "name": "a pane the page does not have is dropped, not refused",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "stored": "{\"tabs\":[\"a\",\"zz\",\"b\"],\"active\":2}",
      "refused": false,
      "expect": {
        "tabs": [
          "a",
          "b"
        ],
        "active": 1
      },
      "written": "{\"tabs\":[\"a\",\"b\"],\"active\":1}"
    },
    {
      "name": "a layout of nothing but panes the page does not have is none",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "stored": "{\"tabs\":[\"zz\",\"yy\"]}",
      "refused": true,
      "expect": {
        "tabs": [
          "a",
          "b",
          "c"
        ],
        "active": 0
      },
      "written": "{\"tabs\":[\"a\",\"b\",\"c\"],\"active\":0}"
    },
    {
      "name": "a leaf emptied by dropping them goes, and its split with it",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "stored": "{\"dir\":\"row\",\"size\":[1,2],\"kids\":[{\"tabs\":[\"zz\"]},{\"tabs\":[\"a\"]}]}",
      "refused": false,
      "expect": {
        "tabs": [
          "a"
        ],
        "active": 0
      },
      "written": "{\"tabs\":[\"a\"],\"active\":0}"
    },
    {
      "name": "the rest of a split keep their shares as they were written",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "stored": "{\"dir\":\"row\",\"size\":[1,2,3],\"kids\":[{\"tabs\":[\"a\"]},{\"tabs\":[\"zz\"]},{\"tabs\":[\"b\"]}]}",
      "refused": false,
      "expect": {
        "dir": "row",
        "size": [
          1,
          3
        ],
        "kids": [
          {
            "tabs": [
              "a"
            ],
            "active": 0
          },
          {
            "tabs": [
              "b"
            ],
            "active": 0
          }
        ]
      },
      "written": "{\"dir\":\"row\",\"size\":[1,3],\"kids\":[{\"tabs\":[\"a\"],\"active\":0},{\"tabs\":[\"b\"],\"active\":0}]}"
    },
    {
      "name": "a pane named twice is kept where it is named first",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "stored": "{\"dir\":\"row\",\"size\":[0.5,0.5],\"kids\":[{\"tabs\":[\"a\",\"b\"]},{\"tabs\":[\"b\",\"c\"]}]}",
      "refused": false,
      "expect": {
        "dir": "row",
        "size": [
          0.5,
          0.5
        ],
        "kids": [
          {
            "tabs": [
              "a",
              "b"
            ],
            "active": 0
          },
          {
            "tabs": [
              "c"
            ],
            "active": 0
          }
        ]
      },
      "written": "{\"dir\":\"row\",\"size\":[0.5,0.5],\"kids\":[{\"tabs\":[\"a\",\"b\"],\"active\":0},{\"tabs\":[\"c\"],\"active\":0}]}"
    },
    {
      "name": "twice in one leaf is once",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "stored": "{\"tabs\":[\"a\",\"a\",\"b\"],\"active\":2}",
      "refused": false,
      "expect": {
        "tabs": [
          "a",
          "b"
        ],
        "active": 1
      },
      "written": "{\"tabs\":[\"a\",\"b\"],\"active\":1}"
    },
    {
      "name": "a split comes back as it was written",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "stored": "{\"dir\":\"row\",\"size\":[0.62,0.38],\"kids\":[{\"dir\":\"col\",\"size\":[0.7,0.3],\"kids\":[{\"tabs\":[\"a\"]},{\"tabs\":[\"b\"]}]},{\"tabs\":[\"c\"]}]}",
      "refused": false,
      "expect": {
        "dir": "row",
        "size": [
          0.62,
          0.38
        ],
        "kids": [
          {
            "dir": "col",
            "size": [
              0.7,
              0.3
            ],
            "kids": [
              {
                "tabs": [
                  "a"
                ],
                "active": 0
              },
              {
                "tabs": [
                  "b"
                ],
                "active": 0
              }
            ]
          },
          {
            "tabs": [
              "c"
            ],
            "active": 0
          }
        ]
      },
      "written": "{\"dir\":\"row\",\"size\":[0.62,0.38],\"kids\":[{\"dir\":\"col\",\"size\":[0.7,0.3],\"kids\":[{\"tabs\":[\"a\"],\"active\":0},{\"tabs\":[\"b\"],\"active\":0}]},{\"tabs\":[\"c\"],\"active\":0}]}"
    },
    {
      "name": "shares are shares, not fractions that add up to one",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "stored": "{\"dir\":\"col\",\"size\":[1,1,2],\"kids\":[{\"tabs\":[\"a\"]},{\"tabs\":[\"b\"]},{\"tabs\":[\"c\"]}]}",
      "refused": false,
      "expect": {
        "dir": "col",
        "size": [
          1,
          1,
          2
        ],
        "kids": [
          {
            "tabs": [
              "a"
            ],
            "active": 0
          },
          {
            "tabs": [
              "b"
            ],
            "active": 0
          },
          {
            "tabs": [
              "c"
            ],
            "active": 0
          }
        ]
      },
      "written": "{\"dir\":\"col\",\"size\":[1,1,2],\"kids\":[{\"tabs\":[\"a\"],\"active\":0},{\"tabs\":[\"b\"],\"active\":0},{\"tabs\":[\"c\"],\"active\":0}]}"
    },
    {
      "name": "fields a split does not have are ignored",
      "panes": [
        "a",
        "b",
        "c"
      ],
      "stored": "{\"dir\":\"row\",\"size\":[1,1],\"active\":3,\"fixed\":250,\"kids\":[{\"tabs\":[\"a\"]},{\"tabs\":[\"b\"]}]}",
      "refused": false,
      "expect": {
        "dir": "row",
        "size": [
          1,
          1
        ],
        "kids": [
          {
            "tabs": [
              "a"
            ],
            "active": 0
          },
          {
            "tabs": [
              "b"
            ],
            "active": 0
          }
        ]
      },
      "written": "{\"dir\":\"row\",\"size\":[1,1],\"kids\":[{\"tabs\":[\"a\"],\"active\":0},{\"tabs\":[\"b\"],\"active\":0}]}"
    },
